<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal IIS configuration for SmarterASP.NET.

  Earlier version of this file added Cache-Control headers via <httpProtocol>
  and <location> overrides. SmarterASP.NET locks the httpProtocol section
  at the parent applicationHost.config level on most plans, which causes
  IIS to return HTTP 500 with "This configuration section cannot be used
  at this path." We dropped that section here.

  All we strictly need from web.config is the .webmanifest MIME mapping —
  IIS doesn't ship with one by default, and modern browsers will reject
  the manifest without the correct application/manifest+json type.

  Cache headers can be added later via a meta http-equiv in index.html
  or by upgrading the SmarterASP.NET plan to one that unlocks httpProtocol.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
