<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for SmarterASP.NET hosting.

  Ships in dist/ alongside index.html. Anything in /public is copied into
  the build output verbatim by Vite.

  Two responsibilities:
    1. MIME types — IIS doesn't ship with a mapping for .webmanifest, and
       its default for .js is the older "application/x-javascript". Both
       are corrected here.
    2. Cache headers — hashed asset bundles are immutable for a year;
       index.html is no-cached so users always pick up references to the
       newest hashed JS.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
    </staticContent>

    <!-- Default: allow long caching. Hashed assets in /assets get the
         immutable directive. -->
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="public, max-age=31536000, immutable" />
      </customHeaders>
    </httpProtocol>

    <!-- Override for index.html — must NOT be long-cached so a returning
         user always gets the latest hashed JS reference. -->
    <location path="index.html">
      <system.webServer>
        <httpProtocol>
          <customHeaders>
            <clear />
            <add name="Cache-Control" value="no-cache, must-revalidate" />
          </customHeaders>
        </httpProtocol>
      </system.webServer>
    </location>

    <!-- Same for the manifest — small and changes more often than hashed assets. -->
    <location path="manifest.webmanifest">
      <system.webServer>
        <httpProtocol>
          <customHeaders>
            <clear />
            <add name="Cache-Control" value="no-cache, must-revalidate" />
          </customHeaders>
        </httpProtocol>
      </system.webServer>
    </location>
  </system.webServer>
</configuration>
